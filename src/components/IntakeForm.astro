---
// Phase 1: static form with client-side thank-you state
// Phase 2: wire action to Formspree endpoint
---

<div id="form-wrapper">
  <form
    id="intake-form"
    class="space-y-6"
    novalidate
  >
    <!-- Name row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="firstName" class="block font-sans text-sm font-medium text-ink">
          First Name <span class="text-teal" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="firstName"
          name="firstName"
          required
          autocomplete="given-name"
          class="w-full border border-border px-4 py-3 font-sans text-sm text-ink placeholder-gray-400 focus:outline-none focus:border-teal focus:ring-1 focus:ring-teal transition-colors bg-white"
          placeholder="Jane"
        />
      </div>
      <div class="space-y-1.5">
        <label for="lastName" class="block font-sans text-sm font-medium text-ink">
          Last Name <span class="text-teal" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="lastName"
          name="lastName"
          required
          autocomplete="family-name"
          class="w-full border border-border px-4 py-3 font-sans text-sm text-ink placeholder-gray-400 focus:outline-none focus:border-teal focus:ring-1 focus:ring-teal transition-colors bg-white"
          placeholder="Smith"
        />
      </div>
    </div>

    <!-- Email -->
    <div class="space-y-1.5">
      <label for="email" class="block font-sans text-sm font-medium text-ink">
        Email Address <span class="text-teal" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full border border-border px-4 py-3 font-sans text-sm text-ink placeholder-gray-400 focus:outline-none focus:border-teal focus:ring-1 focus:ring-teal transition-colors bg-white"
        placeholder="jane@example.com"
      />
    </div>

    <!-- Phone -->
    <div class="space-y-1.5">
      <label for="phone" class="block font-sans text-sm font-medium text-ink">
        Phone Number
        <span class="text-muted font-normal ml-1 text-xs">(optional)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        class="w-full border border-border px-4 py-3 font-sans text-sm text-ink placeholder-gray-400 focus:outline-none focus:border-teal focus:ring-1 focus:ring-teal transition-colors bg-white"
        placeholder="(555) 000-0000"
      />
    </div>

    <!-- How did you hear -->
    <div class="space-y-1.5">
      <label for="source" class="block font-sans text-sm font-medium text-ink">
        How did you hear about SAYA?
      </label>
      <div class="relative">
        <select
          id="source"
          name="source"
          class="w-full appearance-none border border-border px-4 py-3 pr-10 font-sans text-sm text-ink focus:outline-none focus:border-teal focus:ring-1 focus:ring-teal transition-colors bg-white"
        >
          <option value="" disabled selected>Select one...</option>
          <option value="parish">Parish announcement</option>
          <option value="friend">A friend</option>
          <option value="social">Social media</option>
          <option value="bulletin">Church bulletin</option>
          <option value="other">Other</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Areas of interest -->
    <fieldset class="space-y-3">
      <legend class="font-sans text-sm font-medium text-ink block mb-2">
        What are you interested in?
        <span class="text-muted font-normal ml-1 text-xs">(select all that apply)</span>
      </legend>
      {[
        { value: 'social', label: 'Social events' },
        { value: 'adoration', label: 'Adoration & worship' },
        { value: 'service', label: 'Service & outreach' },
        { value: 'faith', label: 'Faith formation & study' },
        { value: 'other', label: 'Other' },
      ].map(({ value, label }) => (
        <label class="flex items-center gap-3 cursor-pointer group">
          <input
            type="checkbox"
            name="interests"
            value={value}
            class="w-4 h-4 border border-border text-teal focus:ring-teal focus:ring-offset-0 rounded-none accent-teal cursor-pointer"
          />
          <span class="font-sans text-sm text-ink group-hover:text-teal transition-colors">
            {label}
          </span>
        </label>
      ))}
    </fieldset>

    <!-- Submit -->
    <div class="pt-2">
      <button
        type="submit"
        id="submit-btn"
        class="btn-primary w-full sm:w-auto min-w-[160px] flex items-center justify-center gap-2"
      >
        <span>Submit</span>
        <svg id="submit-spinner" class="hidden w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
      </button>
      <p class="text-xs text-muted mt-3">
        Your info is only used to help us get in touch and stay connected.
      </p>
    </div>
  </form>

  <!-- Thank you state -->
  <div
    id="thank-you"
    class="hidden text-center py-16 space-y-4"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center justify-center w-16 h-16 rounded-full bg-teal/10 mx-auto">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="font-display text-2xl text-ink">You're all set!</h3>
    <p class="font-sans text-muted max-w-sm mx-auto leading-relaxed">
      Thanks for reaching out. Amy will be in touch soon to welcome you to the community.
    </p>
    <p class="font-sans text-sm text-muted">
      In the meantime, follow us on
      <a href="https://instagram.com/stannyoungadults" class="text-teal hover:underline" target="_blank" rel="noopener">Instagram</a>
      or join our
      <a href="https://groupme.com/join_group/saya" class="text-teal hover:underline" target="_blank" rel="noopener">GroupMe</a>.
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('intake-form') as HTMLFormElement;
  const thankYou = document.getElementById('thank-you') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const spinner = document.getElementById('submit-spinner') as SVGElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Basic validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Simulate async (Phase 2: replace with fetch to Formspree)
    submitBtn.disabled = true;
    spinner.classList.remove('hidden');

    setTimeout(() => {
      form.classList.add('hidden');
      thankYou.classList.remove('hidden');
      thankYou.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 800);
  });
</script>

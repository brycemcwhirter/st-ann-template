---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — SAYA">
  <section class="min-h-screen flex items-center justify-center pt-16">
    <div class="text-center space-y-6 container-narrow">
      <p class="font-sans text-8xl font-bold text-border">404</p>
      <h1 class="font-display text-3xl text-ink">Page not found.</h1>
      <p class="font-sans text-muted leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn-primary inline-block">Back to Home</a>
    </div>
  </section>
</BaseLayout>

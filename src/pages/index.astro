---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import Marquee from '../components/Marquee.astro';
import EventCard from '../components/EventCard.astro';
import type { EventData } from '../components/EventCard.astro';

const marqueeItems = [
  'DECLARE — 2nd & 4th Mondays · 7PM · Chapel at St. Ann',
  'Game Night — March 21 · 7PM · St. Ann Parish Hall',
  'Service Saturday — April 5 · 9AM · Meet at the Church',
  'Holy Week Adoration — April 18 · 8PM · Chapel at St. Ann',
  'Spring Social — May 2 · 6PM · Location TBD',
];

const featuredEvents: EventData[] = [
  {
    title: 'DECLARE Young Adult Night',
    date: '2026-03-23T19:00:00',
    endDate: '2026-03-23T21:00:00',
    location: 'Chapel at St. Ann, Coppell TX',
    description: 'Our bi-weekly gathering for prayer, community, and formation. Come as you are — all are welcome.',
    tag: 'Recurring',
  },
  {
    title: 'Game Night',
    date: '2026-03-21T19:00:00',
    endDate: '2026-03-21T22:00:00',
    location: 'St. Ann Parish Hall, Coppell TX',
    description: 'Board games, snacks, and great company. Bring your favorite game or just show up!',
    tag: 'Social',
  },
  {
    title: 'Service Saturday',
    date: '2026-04-05T09:00:00',
    endDate: '2026-04-05T12:00:00',
    location: 'St. Ann Catholic Church, Coppell TX',
    description: 'Give back to the community alongside fellow young adults. We\'ll be serving at a local food pantry.',
    tag: 'Service',
  },
];
---

<BaseLayout title="SAYA — St. Ann Young Adults" description="A community of young Catholic adults at St. Ann Parish in Coppell, TX.">

  <!-- ═══════════════════════════════════════════ HERO -->
  <HeroSlideshow />

  <!-- ═══════════════════════════════════════════ MARQUEE -->
  <Marquee items={marqueeItems} />

  <!-- ═══════════════════════════════════════════ ABOUT -->
  <section class="py-24 md:py-32 bg-background" aria-label="About SAYA">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Text left -->
        <div class="space-y-6 reveal">
          <p class="font-sans text-xs font-medium tracking-[0.25em] uppercase text-teal">
            Who We Are
          </p>
          <h2 class="section-heading">
            A place where intentional friendships are made.
          </h2>
          <div class="space-y-4 text-muted font-sans text-base leading-relaxed">
            <p>
              SAYA is the young adult community at St. Ann Catholic Church in Coppell, TX — a gathering space for Catholics in their 20s and 30s who are hungry for more than surface-level connection.
            </p>
            <p>
              Whether you're a lifelong Catholic or just exploring your faith, you'll find a place here. We gather for prayer, service, social events, and honest conversations about what it means to follow Christ in everyday life.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a href="/connect" class="btn-primary">Join the Community</a>
            <a href="/events" class="btn-outline">See What's Coming Up</a>
          </div>
        </div>

        <!-- Image right -->
        <div class="relative reveal" style="transition-delay: 150ms">
          <div class="aspect-[4/5] bg-gradient-to-br from-background-alt to-gray-200 overflow-hidden">
            <!-- Phase 2: real community photo -->
            <div class="w-full h-full flex items-center justify-center text-center p-8">
              <div class="space-y-3">
                <div class="w-16 h-16 rounded-full bg-teal/20 flex items-center justify-center mx-auto">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <p class="font-sans text-sm text-muted">Community photo</p>
                <p class="font-sans text-xs text-gray-400">Placeholder — add your photo to /public/images/</p>
              </div>
            </div>
          </div>
          <!-- Decorative accent -->
          <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-teal/10 -z-10"></div>
          <div class="absolute -top-4 -left-4 w-16 h-16 border border-border -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ EVENTS PREVIEW -->
  <section class="py-24 md:py-32 bg-background-alt" aria-label="Upcoming events">
    <div class="container-wide">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12 reveal">
        <div>
          <p class="font-sans text-xs font-medium tracking-[0.25em] uppercase text-teal mb-3">
            What's Coming Up
          </p>
          <h2 class="section-heading">Upcoming Events</h2>
        </div>
        <a href="/events" class="btn-outline shrink-0">
          View All Events
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredEvents.map((event, i) => (
          <div class="reveal" style={`transition-delay: ${i * 100}ms`}>
            <EventCard event={event} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ STAFF -->
  <section class="py-24 md:py-32 bg-background" aria-label="Our team">
    <div class="container-wide">
      <div class="max-w-xl mb-12 reveal">
        <p class="font-sans text-xs font-medium tracking-[0.25em] uppercase text-teal mb-3">
          Our Team
        </p>
        <h2 class="section-heading">Say hello.</h2>
      </div>

      <div class="max-w-sm reveal" style="transition-delay: 100ms">
        <div class="group bg-white border border-border p-8 space-y-4 hover:border-teal transition-colors">
          <!-- Photo placeholder -->
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-teal/20 to-teal/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <p class="font-display text-xl text-ink">Amy Kitzman</p>
            <p class="font-sans text-sm text-teal mt-0.5">Young Adult Ministry Coordinator</p>
          </div>
          <p class="font-sans text-sm text-muted leading-relaxed">
            Amy is passionate about building intentional community and helping young adults find their place in the Church.
          </p>
          <a
            href="mailto:amy.kitzman@stannchurch.org"
            class="inline-flex items-center gap-2 font-sans text-sm text-teal hover:text-teal-dark transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            amy.kitzman@stannchurch.org
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CTA BANNER -->
  <section class="py-20 md:py-28 bg-teal" aria-label="New here call to action">
    <div class="container-wide text-center space-y-6 reveal">
      <p class="font-sans text-xs font-medium tracking-[0.3em] uppercase text-white/60">
        New to SAYA?
      </p>
      <h2 class="font-display text-4xl md:text-5xl text-white leading-tight max-w-xl mx-auto">
        New here? We'd love to meet you.
      </h2>
      <p class="font-sans text-white/70 text-base max-w-md mx-auto leading-relaxed">
        Fill out a quick form and Amy will reach out personally to welcome you into the community.
      </p>
      <div class="pt-2">
        <a href="/connect" class="btn-white">
          Say Hello
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
